# Copia este archivo a ".env" y ajusta las URLs según tu despliegue.
# En producción, estas deberían apuntar al AWS API Gateway (HTTPS) que expone
# cada microservicio, no directamente a las VMs privadas.

# MS1 - Catálogo (Categorías, Productos, Inventario) — FastAPI, puerto 8000
VITE_MS1_URL=

# MS3 - Carrito de compras — Spring Boot, puerto 8083
# URL completa de la colección usada por el cliente MS3.
VITE_MS3_API_URL=

# MS5 - Analítica (AWS Athena) — Spring Boot, puerto 8080
VITE_MS5_URL=

# MS2 - Clientes / Pedidos / Pago
VITE_MS2_URL=

# MS4 - Orquestador. URL base incluyendo /ms4 (sin /checkout).
# Local: http://localhost:8083/ms4; en Amplify usa la URL HTTPS pública.
VITE_MS4_URL=

# Vendedor único (dueño de la tienda, sube productos y ve el panel /analitica
# con datos de MS5). MS2 no modela roles, así que esta cuenta NO es un
# Cliente de MS2: se valida solo contra estas credenciales fijas del front.
# Cualquier otro correo que inicie sesión es un cliente normal.
VITE_VENDEDOR_EMAIL=admin3@tienda.com
VITE_VENDEDOR_PASSWORD=admin3123
VITE_VENDEDOR_NOMBRE=Administrador
